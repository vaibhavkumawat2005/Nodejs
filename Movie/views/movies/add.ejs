<!DOCTYPE html>
<html>
<head>
    <title>Add Movie</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center p-6">

    <div class="bg-gray-800 p-8 rounded-2xl shadow-lg w-full max-w-4xl">
        <h1 class="text-3xl font-bold mb-6 text-center text-yellow-400">🎬 Add New Movie</h1>

        <% if (error) { %>
            <p class="text-red-400 mb-4"><%= error %></p>
        <% } %>

        <form action="/movies/add" method="POST" enctype="multipart/form-data" class="space-y-4">
            
            <div class="grid grid-cols-2 gap-6">
                <!-- Title -->
                <div class="flex items-center gap-4">
                    <label for="title" class="w-32 text-right">Title:</label>
                    <input type="text" id="title" name="title" required class="flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:border-yellow-400">
                </div>

                <!-- Director -->
                <div class="flex items-center gap-4">
                    <label for="director" class="w-32 text-right">Director:</label>
                    <input type="text" id="director" name="director" required class="flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:border-yellow-400">
                </div>

                <!-- Description -->
                <div class="flex items-center gap-4 col-span-2">
                    <label for="description" class="w-32 text-right">Description:</label>
                    <textarea id="description" name="description" required class="flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:border-yellow-400"></textarea>
                </div>

                <!-- Rating -->
                <div class="flex items-center gap-4">
                    <label for="rating" class="w-32 text-right">Rating:</label>
                    <input type="number" id="rating" name="rating" min="0" max="10" step="0.1" required class="flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:border-yellow-400">
                </div>

                <!-- Release Date -->
                <div class="flex items-center gap-4">
                    <label for="releaseDate" class="w-32 text-right">Release Date:</label>
                    <input type="date" id="releaseDate" name="releaseDate" required class="flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:border-yellow-400">
                </div>

                <!-- Poster -->
                <div class="flex items-center gap-4 col-span-2">
                    <label for="posterImage" class="w-32 text-right">Poster Image:</label>
                    <input type="file" id="posterImage" name="posterImage" accept="image/*" class="flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:border-yellow-400">
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex justify-between mt-6">
                <a href="/movies" class="px-6 py-2 bg-gray-600 hover:bg-gray-500 rounded-lg text-white">⬅ Back</a>
                <button type="submit" class="px-6 py-2 bg-yellow-500 hover:bg-yellow-400 text-black font-semibold rounded-lg">Add Movie</button>
            </div>
        </form>
    </div>

</body>
</html>
