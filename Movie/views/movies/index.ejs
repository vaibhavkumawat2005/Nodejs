<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movies | MovieFlix</title>
    <link rel="stylesheet" href="/css/output.css">
   <style>
    .movie-card {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(8px);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .movie-card:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 15px 25px rgba(0, 0, 0, 0.6);
    }
    .movie-poster {
        object-fit: contain; /* ✅ show full image */
        width: 100%;
        height: 320px; /* keep same box height */
        background-color: black; /* fill empty space */
        transition: transform 0.4s ease;
    }
    .movie-card:hover .movie-poster {
        transform: scale(1.05);
    }
    .poster-overlay {
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 50%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    }
    .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px; /* space between icon and text */
    font-weight: 600;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.25s ease;
    height: 42px; /* consistent height */
}

.edit-btn {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
}
.edit-btn:hover {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    transform: translateY(-1px);
}

.delete-btn {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
}
.delete-btn:hover {
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    transform: translateY(-1px);
}

</style>

</head>
<body class="bg-gradient-to-br from-gray-900 via-black to-gray-900 text-white min-h-screen flex flex-col">

    <!-- Header -->
    <header class="py-6 text-center border-b border-gray-800 shadow-lg">
        <h1 class="text-4xl font-extrabold tracking-wider text-yellow-400 drop-shadow-lg">
            🎥 Movie<span class="text-white">Flix</span>
        </h1>
        <p class="text-gray-400 mt-1 italic">Lights. Camera. Action. Your collection, reimagined.</p>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-10">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-2xl font-bold text-yellow-400">🎬 Movies List</h2>
            <div class="flex gap-4">
                <a href="/movies/add" 
                   class="bg-yellow-400 text-gray-900 px-5 py-2 rounded-lg font-semibold hover:bg-yellow-500 focus:ring-2 focus:ring-yellow-300 transition">
                    ➕ Add Movie
                </a>
                <a href="/auth/logout" 
                   class="bg-red-600 text-white px-5 py-2 rounded-lg hover:bg-red-700 focus:ring-2 focus:ring-red-400 transition">
                    🚪 Logout
                </a>
            </div>
        </div>

        <!-- Movies Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
            <% if (movies.length === 0) { %>
                <p class="text-center text-gray-400 col-span-full">No movies available</p>
            <% } else { %>
                <% movies.forEach(movie => { %>
                    <div class="movie-card group">
                        <% if (movie.posterImage) { %>
                            <img src="/uploads/<%= movie.posterImage %>" class="movie-poster" alt="<%= movie.title %> poster">
                        <% } else { %>
                            <img src="/default-poster.jpg" class="movie-poster" alt="Default poster">
                        <% } %>
                        <div class="poster-overlay"></div>
                        <div class="p-4 relative z-10">
                            <h2 class="text-xl font-bold text-white truncate"><%= movie.title %></h2>
                            <p class="text-gray-400 text-sm mb-3">🎬 Directed by <%= movie.director %></p>
                            <div class="flex justify-between text-sm text-gray-300">
                                <span>⭐ <%= movie.Rating %></span>
                                <span><%= movie.releaseDate.toDateString() %></span>
                            </div>
                            <!-- Action Buttons -->
                          <div class="flex gap-3 mt-4">
    <a href="/movies/edit/<%= movie._id %>" class="flex-1 action-btn edit-btn">
        ✏ Edit
    </a>
    <form action="/movies/delete/<%= movie._id %>" method="POST" class="flex-1">
        <button type="submit" class="w-full action-btn delete-btn">
            🗑 Delete
        </button>
    </form>
</div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-500 text-center py-4 text-sm border-t border-gray-800 mt-8">
        &copy; 2025 <span class="text-yellow-400">MovieFlix</span>. All rights reserved. 🍿
    </footer>

</body>
</html>
