<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Bookstore</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="logo">
        <h1>Bookstore</h1>
      </div>
      <nav>
        <a href="/">Home</a>
        <a href="/addBook" class="add-book-btn">Add Book</a>
      </nav>
    </div>
  </header>

  <main>
    <h2>Featured Books</h2>

    <% if (book.length === 0) { %>
      <p>No books added yet.</p>
    <% } else { %>
      <div class="book-grid">
        <% book.forEach(b => { %>
          <div class="book-card">
            <img src="/uploads/<%= b.coverImage %>" alt="<%= b.title %>" width="150" height="200">
            <h3><%= b.title %></h3>
            <p class="author">by <%= b.author %></p>
            <p class="description"><%= b.description %></p>
            <p class="price">₹<%= b.price %></p>
            <p class="published">Published: <%= b.publishedDate.toDateString() %></p>

            <!-- ✅ Delete Form -->
            <form action="/book/delete/<%= b._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this book?');">
              <button type="submit" class="delete-btn">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <footer>
    <p>© 2025 Bookstore. All rights reserved.</p>
  </footer>
</body>
</html>
